---
import type { MarkdownHeading } from 'astro';
import DocsHeader from '../components/DocsHeader.astro';
import { docUrl, type Doc } from '../lib/docs';
import '../styles/docs.css';

interface Props {
  title: string;
  description?: string;
  docs: Doc[];
  current?: string;
  headings?: MarkdownHeading[];
  prev?: Doc;
  next?: Doc;
}

const { title, description, docs, current, headings = [], prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<a class="skip-link" href="#docs-content">Skip to content</a>
<DocsHeader />

<div class="container docs__grid" data-toc={String(toc.length > 0)}>
  <aside class="docs__sidebar">
    <nav aria-label="Documentation">
      <a class="docs__sidebar-title" href={`${base}docs/`} aria-current={!current ? 'page' : undefined}>
        Documentation
      </a>
      {docs.length > 0 && (
        <ul>
          {docs.map((doc) => (
            <li>
              <a href={docUrl(doc.id)} aria-current={doc.id === current ? 'page' : undefined}>
                {doc.data.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </nav>
  </aside>

  <main id="docs-content" class="docs__main">
    <article class="docs-prose">
      <h1>{title}</h1>
      {description && <p class="docs__lead">{description}</p>}
      <slot />
    </article>

    {(prev || next) && (
      <nav class="docs__pager" aria-label="Documentation pages">
        {prev && (
          <a class="docs__pager-link" href={docUrl(prev.id)}>
            <span>Previous</span>
            <strong>{prev.data.title}</strong>
          </a>
        )}
        {next && (
          <a class="docs__pager-link docs__pager-link--next" href={docUrl(next.id)}>
            <span>Next</span>
            <strong>{next.data.title}</strong>
          </a>
        )}
      </nav>
    )}
  </main>

  {toc.length > 0 && (
    <nav class="docs__toc" aria-label="On this page">
      <p>On this page</p>
      <ul>
        {toc.map((heading) => (
          <li class={`docs__toc-item docs__toc-item--${heading.depth}`}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</div>
