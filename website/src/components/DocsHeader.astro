---
import lightLogo from '../assets/logo-light.svg?url';
import darkLogo from '../assets/logo-dark.svg?url';
import DocsThemeSwitch from './DocsThemeSwitch.astro';
import { copies, links } from '../copy';

const base = import.meta.env.BASE_URL;
---

<header class="nav docs-header">
  <div class="container nav__inner">
    <a class="brand" href={base} aria-label="NSGo">
      <img class="brand__logo docs-logo docs-logo--dark" src={darkLogo} width="26" height="26" alt="" draggable="false" />
      <img class="brand__logo docs-logo docs-logo--light" src={lightLogo} width="26" height="26" alt="" draggable="false" />
      <span class="brand__name">NSGo</span>
      <span class="brand__tag">Docs</span>
    </a>

    <div class="nav__actions docs-header__actions">
      <DocsThemeSwitch />
      <a
        class="nav__github"
        href={links.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={copies.en.nav.github}
        title={copies.en.nav.github}
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
        </svg>
        <span>{copies.en.nav.github}</span>
      </a>
    </div>
  </div>
</header>
