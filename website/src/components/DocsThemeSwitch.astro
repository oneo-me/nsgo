---
import { copies } from '../copy';

const labels = copies.en.nav.theme;
const options = [
  { value: 'system', label: labels.system, icon: 'monitor' },
  { value: 'light', label: labels.light, icon: 'sun' },
  { value: 'dark', label: labels.dark, icon: 'moon' },
] as const;
---

<div class="theme-switch" role="group" aria-label={labels.label}>
  {options.map((option) => (
    <button
      type="button"
      class="theme-switch__button"
      data-theme-option={option.value}
      aria-pressed="false"
      aria-label={option.label}
      title={option.label}
    >
      {option.icon === 'monitor' && (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="12" rx="2" />
          <path d="M9 20h6M12 16v4" />
        </svg>
      )}
      {option.icon === 'sun' && (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      )}
      {option.icon === 'moon' && (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
        </svg>
      )}
    </button>
  ))}
</div>

<script>
  import { applyTheme, readPreference, resolveTheme, storePreference } from '../theme';

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  let preference = readPreference();

  const update = () => {
    applyTheme(resolveTheme(preference, media.matches));
    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeOption === preference));
    });
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const value = button.dataset.themeOption;
      if (value !== 'system' && value !== 'light' && value !== 'dark') return;
      preference = value;
      storePreference(preference);
      update();
    });
  });

  media.addEventListener('change', update);
  update();
</script>
