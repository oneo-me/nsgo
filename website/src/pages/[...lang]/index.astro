---
import { Code } from 'astro:components';
import Eyebrow from '../../components/Eyebrow.astro';
import HeroField from '../../components/HeroField.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import SpeedLines from '../../components/SpeedLines.astro';
import { copies } from '../../copy';
import Layout from '../../layouts/Layout.astro';
import { docUrl, langOf, langPaths, links, pageUrl, platformName, platformRows, platforms, platformsOf, shown } from '../../site';
import { goApp, goTest, tsxApp } from '../../snippets';
import desktopEn from '../../assets/screens/desktop-en.jpg';
import desktopZh from '../../assets/screens/desktop-zh.jpg';
import phoneEn from '../../assets/screens/phone-en.jpg';
import phoneZh from '../../assets/screens/phone-zh.jpg';

export const getStaticPaths = () => langPaths('home');

const lang = langOf(Astro.params.lang);
const copy = copies[lang];
const home = copy.home;
const f = home.features;
const desktop = lang === 'zh' ? desktopZh : desktopEn;
const phone = lang === 'zh' ? phoneZh : phoneEn;

// Where each platform's tile sits beside the hero's copy, in points of a
// 480 by 300 board, and the shape of the device or surface it runs on. The
// board has three columns, desktops, phones and the rest, with 12 points
// between every tile.
type Shape = 'window' | 'browser' | 'phone' | 'clip' | 'watch' | 'tv' | 'capsule';
const tiles: Record<string, { shape: Shape; x: number; y: number; w: number; h: number; controls?: 'left' | 'right' }> = {
  macOS: { shape: 'window', controls: 'left', x: 0, y: 0, w: 156, h: 92 },
  Windows: { shape: 'window', controls: 'right', x: 0, y: 104, w: 156, h: 92 },
  Linux: { shape: 'window', controls: 'right', x: 0, y: 208, w: 156, h: 92 },
  iOS: { shape: 'phone', x: 168, y: 0, w: 72, h: 144 },
  Android: { shape: 'phone', x: 168, y: 156, w: 72, h: 144 },
  tvOS: { shape: 'tv', x: 252, y: 0, w: 148, h: 84 },
  watchOS: { shape: 'watch', x: 412, y: 0, w: 68, h: 92 },
  'App Clips': { shape: 'clip', x: 254, y: 106, w: 88, h: 88 },
  Web: { shape: 'browser', x: 356, y: 104, w: 124, h: 92 },
  WeChat: { shape: 'capsule', x: 252, y: 208, w: 108, h: 40 },
  QQ: { shape: 'capsule', x: 372, y: 208, w: 108, h: 40 },
  Alipay: { shape: 'capsule', x: 252, y: 260, w: 108, h: 40 },
  Douyin: { shape: 'capsule', x: 372, y: 260, w: 108, h: 40 },
};

const tabs = [
  { id: 'go', file: 'main.go', code: goApp, lang: 'go' },
  { id: 'tsx', file: 'App.tsx', code: tsxApp, lang: 'tsx' },
  { id: 'test', file: 'app_test.go', code: goTest, lang: 'go' },
] as const;

const next: { icon: IconName; title: string; body: string; href: string; external?: boolean }[] = [
  { icon: 'book', ...copy.guides.docs, href: pageUrl(lang, 'docs') },
  ...(shown('components') ? [{ icon: 'box' as const, ...copy.guides.components, href: pageUrl(lang, 'components') }] : []),
  { icon: 'play', ...copy.guides.demo, href: links.gallery, external: true },
  ...(shown('showcases') ? [{ icon: 'image' as const, ...copy.guides.showcases, href: pageUrl(lang, 'showcases') }] : []),
  ...(shown('benchmarks') ? [{ icon: 'gauge' as const, ...copy.guides.benchmarks, href: pageUrl(lang, 'benchmarks') }] : []),
  { icon: 'map', ...copy.guides.architecture, href: links.architecture, external: true },
  { icon: 'github', ...copy.guides.github, href: links.repo, external: true },
];
---

<Layout lang={lang} page="home" path="" title={home.title} description={home.description}>
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <HeroField />
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="pill"><SpeedLines size={14} />{home.hero.badge}</span>
        <h1>
          {home.hero.title[0]}
          <span class="gradient-text">{home.hero.title[1]}</span>
        </h1>
        <p class="hero__lead">{home.hero.lead[0]}<strong>{platforms.length}</strong>{home.hero.lead[1]}</p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--large" href={docUrl(lang, 'getting-started')}>
            {home.hero.start}
          </a>
          <a class="btn btn--secondary btn--large" href={links.gallery} target="_blank" rel="noopener noreferrer" data-umami-event="open-gallery">
            {home.hero.demo}
          </a>
        </div>
      </div>

      <div class="hero__platforms">
        <ul class="tiles" aria-label={home.hero.runsOn}>
          {platforms.map((platform, index) => {
            const tile = tiles[platform.name]!;
            return (
              <li
                class:list={['platform', `platform--${tile.shape}`, tile.controls && `platform--controls-${tile.controls}`]}
                style={`--i: ${index}; --x: ${tile.x}; --y: ${tile.y}; --w: ${tile.w}; --h: ${tile.h}`}
                tabindex={platform.experimental ? 0 : undefined}
                aria-describedby={platform.experimental ? `platform-tip-${index}` : undefined}
              >
                <Icon name={platform.icon} size={18} />
                <span class="platform__name">{platformName(platform, lang)}</span>
                {platform.experimental && (
                  <>
                    <span class="platform__mark"></span>
                    <span class="platform__tip" role="tooltip" id={`platform-tip-${index}`}>{home.hero.experimental}</span>
                  </>
                )}
              </li>
            );
          })}
        </ul>
        <div class="platform-lines" aria-hidden="true">
          {platforms.map((platform) => (
            <p class="platform-line">
              <strong>{platformName(platform, lang)}</strong>{home.hero.drawsWith[0]}<span>{platform.stack}</span>{home.hero.drawsWith[1]}
            </p>
          ))}
        </div>
      </div>
    </div>

    <div class="container stage">
      <figure class="screen">
        <img src={desktop.src} width={desktop.width} height={desktop.height} alt={home.hero.desktopAlt} />
      </figure>
      <figure class="phone">
        <img src={phone.src} width={phone.width} height={phone.height} alt={home.hero.phoneAlt} />
      </figure>
    </div>
  </section>

  <section class="section" id="how">
    <div class="container">
      <header class="section__head section__head--center">
        <Eyebrow>{home.how.eyebrow}</Eyebrow>
        <h2>{home.how.title}</h2>
        <p>{home.how.lead}</p>
      </header>
      <ol class="flow">
        {home.how.nodes.map((node, index) => (
          <>
            <li class:list={['flow__node', { 'flow__node--engine': index === 1 }]}>
              <span class="flow__label">{node.label}</span>
              <strong>{node.title}</strong>
              <ul>
                {node.items.map((item) => <li>{item}</li>)}
              </ul>
            </li>
            {index < home.how.links.length && (
              <li class="flow__link" aria-hidden="true">
                <span class="flow__track"><i></i><i></i><i></i></span>
                <span class="flow__caption">{home.how.links[index]}</span>
              </li>
            )}
          </>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--soft" id="features">
    <div class="container">
      <header class="section__head">
        <Eyebrow>{f.eyebrow}</Eyebrow>
        <h2>{f.title}</h2>
      </header>
      <div class="bento">
        <article class="bento__card bento__card--wide">
          <span class="bento__icon"><Icon name="layers" size={18} /></span>
          <h3>{f.native.title}</h3>
          <p>{f.native.body}</p>
          {platformRows.flat().map((kind) => (
            <>
              <h4 class="stacks__kind">{home.hero.kinds[kind]}</h4>
              <ul class="stacks">
                {platformsOf(kind).map(({ platform }) => (
                  <li>
                    <Icon name={platform.icon} size={15} />
                    <strong>{platformName(platform, lang)}</strong>
                    <span>{platform.stack}</span>
                  </li>
                ))}
              </ul>
            </>
          ))}
        </article>
        <article class="bento__card">
          <span class="bento__icon"><Icon name="bolt" size={18} /></span>
          <h3>{f.reactive.title}</h3>
          <p>{f.reactive.body}</p>
          <div class="signal" aria-hidden="true">
            <span class="signal__source">count</span>
            <span class="signal__wire"></span>
            <span class="signal__reader">Text</span>
          </div>
        </article>
        <article class="bento__card">
          <span class="bento__icon"><Icon name="layout" size={18} /></span>
          <h3>{f.layout.title}</h3>
          <p>{f.layout.body}</p>
          <code class="bento__snippet">flex-row gap-3 p-6 md:grid-cols-2</code>
        </article>
        <article class="bento__card bento__card--wide">
          <span class="bento__icon"><Icon name="box" size={18} /></span>
          <h3>{f.components.title}</h3>
          <p>{f.components.body}</p>
          <ul class="chips">
            {f.components.chips.map((chip) => <li>{chip}</li>)}
          </ul>
        </article>
        <article class="bento__card">
          <span class="bento__icon"><Icon name="code" size={18} /></span>
          <h3>{f.tsx.title}</h3>
          <p>{f.tsx.body}</p>
        </article>
        <article class="bento__card">
          <span class="bento__icon"><Icon name="test" size={18} /></span>
          <h3>{f.tests.title}</h3>
          <p>{f.tests.body}</p>
        </article>
        <a class="bento__card bento__card--link" href={docUrl(lang, 'embedding')}>
          <span class="bento__icon"><Icon name="book" size={18} /></span>
          <h3>{f.embed.title}</h3>
          <p>{f.embed.body}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section" id="code">
    <div class="container code">
      <div class="code__copy">
        <header class="section__head">
          <Eyebrow>{home.code.eyebrow}</Eyebrow>
          <h2>{home.code.title}</h2>
          <p>{home.code.lead}</p>
        </header>
        <ol class="code__points">
          {home.code.points.map((point, index) => (
            <li>
              <span class="code__n">{index + 1}</span>
              <div>
                <strong>{point.title}</strong>
                <p>{point.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="code__demo">
        <div class="editor">
          <div class="editor__tabs" role="tablist">
            {tabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-${tab.id}`}
                class="editor__tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`panel-${tab.id}`}
                tabindex={index === 0 ? 0 : -1}
              >
                {tab.file}
              </button>
            ))}
          </div>
          {tabs.map((tab, index) => (
            <div
              class="editor__panel"
              role="tabpanel"
              id={`panel-${tab.id}`}
              aria-labelledby={`tab-${tab.id}`}
              hidden={index !== 0}
            >
              <Code code={tab.code} lang={tab.lang} theme="css-variables" />
            </div>
          ))}
        </div>
        <div class="result">
          <span class="result__label">{home.code.result}</span>
          <p class="result__count" data-count="0">Pressed 0 times</p>
          <button type="button" class="result__press">Press me</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="workflow">
    <div class="container">
      <header class="section__head section__head--center">
        <Eyebrow>{home.workflow.eyebrow}</Eyebrow>
        <h2>{home.workflow.title}</h2>
        <p>{home.workflow.lead}</p>
      </header>
      <ol class="steps">
        {home.workflow.steps.map((step, index) => (
          <li class="step">
            <span class="step__n">{String(index + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
            <code><span class="prompt">$ </span>{step.command}</code>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--next">
    <div class="container">
      <header class="section__head">
        <Eyebrow>{home.next.eyebrow}</Eyebrow>
        <h2>{home.next.title}</h2>
      </header>
      <ul class="cards">
        {next.map((card) => (
          <li>
            <a
              class="card"
              href={card.href}
              {...(card.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              {...(card.href === links.gallery ? { 'data-umami-event': 'open-gallery' } : {})}
            >
              <span class="card__icon"><Icon name={card.icon} size={18} /></span>
              <span class="card__title">{card.title}</span>
              <span class="card__body">{card.body}</span>
              <Icon name={card.external ? 'external' : 'arrow'} size={16} class="card__arrow" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.editor__tab'));
  const select = (tab: HTMLButtonElement) => {
    tabs.forEach((other) => {
      const selected = other === tab;
      other.setAttribute('aria-selected', String(selected));
      other.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(other.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !selected;
    });
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(index + step + tabs.length) % tabs.length]!;
      select(next);
      next.focus();
    });
  });

  // The platforms take turns being lit, with the line under them naming
  // what draws the lit one. Pointing at one lights and holds it; the turns
  // stop when the reader asked for less motion.
  const platformItems = Array.from(document.querySelectorAll<HTMLElement>('.platform'));
  const platformLines = Array.from(document.querySelectorAll<HTMLElement>('.platform-line'));
  let lit = 0;
  let held = false;
  const light = (index: number) => {
    platformItems.forEach((item, i) => item.classList.toggle('is-lit', i === index));
    platformLines.forEach((line, i) => line.classList.toggle('is-lit', i === index));
  };
  platformItems.forEach((item, index) => {
    item.addEventListener('pointerenter', () => {
      held = true;
      lit = index;
      light(index);
    });
    item.addEventListener('pointerleave', () => (held = false));
  });
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    light(lit);
  } else {
    window.setTimeout(() => {
      light(lit);
      window.setInterval(() => {
        if (held) return;
        lit = (lit + 1) % platformItems.length;
        light(lit);
      }, 2200);
    }, 900);
  }

  const count = document.querySelector<HTMLElement>('.result__count');
  document.querySelector('.result__press')?.addEventListener('click', () => {
    if (!count) return;
    const n = Number(count.dataset.count) + 1;
    count.dataset.count = String(n);
    count.textContent = `Pressed ${n} times`;
  });
</script>
