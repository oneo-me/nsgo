---
import Icon from '../../components/Icon.astro';
import { copies } from '../../copy';
import Layout from '../../layouts/Layout.astro';
import { casesIn } from '../../lib/cases';
import { formatStars, withStars } from '../../lib/stars';
import { langOf, langPaths, links, platformName } from '../../site';

export const getStaticPaths = () => langPaths('showcases');

const lang = langOf(Astro.params.lang);
const copy = copies[lang].showcases;
const cases = await withStars(casesIn(lang));
---

<Layout lang={lang} page="showcases" path="showcases/" title={copy.title} description={copy.description}>
  <section class="collection-hero">
    <div class="container">
      <div class="collection-hero__inner">
        <h1>{copy.heading}</h1>
        <p class="collection-hero__lead">{copy.lead}</p>
      </div>
    </div>
  </section>

  <section class="collection">
    <div class="container">
      <div class="collection-grid">
        {cases.map((entry) => (
          <article class="collection-card">
            <figure class="collection-card__screen">
              <img
                src={entry.screen.src}
                width={entry.screen.width}
                height={entry.screen.height}
                alt={entry.screen.alt}
                loading="lazy"
              />
            </figure>
            <div class="collection-card__body">
              <h2>{entry.name}</h2>
              <p
                class="collection-card__summary"
                lang={entry.translated || lang === 'en' ? undefined : 'en'}
                set:html={entry.summary}
              />
              {entry.platforms.length > 0 && (
                <ul class="collection-card__platforms" aria-label={copy.platforms}>
                  {entry.platforms.map((platform) => (
                    <li>
                      <Icon name={platform.icon} size={13} />
                      {platformName(platform, lang)}
                    </li>
                  ))}
                </ul>
              )}
              {(entry.author || entry.site || entry.source || entry.stars !== undefined) && (
                <footer class="collection-card__foot">
                  {entry.author && <span class="collection-card__author">{copy.by} {entry.author}</span>}
                  <span class="collection-card__links">
                    {entry.stars !== undefined && (
                      <span class="collection-card__stars" title={copy.stars} aria-label={`${copy.stars}: ${entry.stars}`}>
                        <Icon name="star" size={12} />
                        {formatStars(entry.stars)}
                      </span>
                    )}
                    {entry.site && (
                      <a
                        href={entry.site}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${copy.visit}: ${entry.name}`}
                      >
                        {copy.visit}
                        <Icon name="external" size={12} />
                      </a>
                    )}
                    {entry.source && (
                      <a
                        href={entry.source}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${copy.source}: ${entry.name}`}
                      >
                        {copy.source}
                        <Icon name="github" size={12} />
                      </a>
                    )}
                  </span>
                </footer>
              )}
            </div>
          </article>
        ))}
      </div>

      <aside class="collection-submit">
        <div>
          <h2>{copy.submit.title}</h2>
          <p>{copy.submit.body}</p>
        </div>
        <a class="btn btn--primary" href={links.cases} target="_blank" rel="noopener noreferrer">
          {copy.submit.action}
          <Icon name="arrow" size={14} />
        </a>
      </aside>
    </div>
  </section>
</Layout>
