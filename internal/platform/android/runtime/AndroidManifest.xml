<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest of a standalone NSGo app. nsgo build sets the package,
  version and label of each app and encodes the result into the APK's
  binary XML. The runtime starts the app's Go executable from the native
  library directory, so native libraries must be extracted; NsgoActivity
  handles the configuration changes below itself instead of restarting
  the app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.oneo.nsgo.app"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The runtime tells the app the network's DNS servers. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:label="NSGo"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name="dev.oneo.nsgo.NsgoActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="dev.oneo.nsgo.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
        <!-- Serves the app's files to the apps it hands them to: the
             clipboard's image, a file it opens and the files it shares;
             nsgo build names its authority after the app's package. -->
        <provider
            android:name="dev.oneo.nsgo.FileProvider"
            android:authorities="dev.oneo.nsgo.app.nsgo.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
